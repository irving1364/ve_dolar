# Base de datos (Vercel Postgres inyecta DATABASE_URL automáticamente en producción)
# Para desarrollo local, usa tu propia instancia PostgreSQL o Vercel Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vedolar"

# API Key de Groq (gratis en https://console.groq.com)
GROQ_API_KEY="gsk_your-groq-api-key"

# Telegram (opcional) — para notificaciones de trades
# Crea un bot en https://t.me/BotFather y obtén el token
# Envía /start al bot y visita https://api.telegram.org/bot<TOKEN>/getUpdates para obtener tu chat_id
TELEGRAM_BOT_TOKEN="your-bot-token"

# Secreto compartido para autorizar llamadas a /api/cron (usado por el workflow de GitHub Actions)
CRON_SECRET="generate-a-long-random-string"

# Auth.js / NextAuth — genera con `npx auth secret` o `openssl rand -base64 32`
AUTH_SECRET="generate-a-long-random-string"

# OAuth de Google (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <tu-dominio>/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"
