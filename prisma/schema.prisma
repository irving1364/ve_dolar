generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  trades        Trade[]
  settings      UserSettings?
  priceAlerts   PriceAlert[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserSettings {
  id                Int       @id @default(autoincrement())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramChatId    String?
  notifications     Boolean   @default(true)
  linkCode          String?   @unique
  linkCodeExpiresAt DateTime?
  lastStableNotifiedAt DateTime?
  updatedAt         DateTime  @updatedAt
}

model Rate {
  id         Int      @id @default(autoincrement())
  source     String
  exchange   String?
  price      Float
  buyPrice   Float?
  sellPrice  Float?
  buyVolume  Float?
  sellVolume Float?
  fetchedAt  DateTime @default(now())

  @@index([source, exchange, fetchedAt])
}

model BankOpening {
  id        Int      @id @default(autoincrement())
  date      DateTime
  bank      String
  mechanism String
  time      String
  duration  String?
  createdAt DateTime @default(now())

  @@unique([date, bank, mechanism, time])
  @@index([date])
}

model PriceAlert {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction   String // "above" | "below"
  targetPrice Float
  active      Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model Trade {
  id          Int        @id @default(autoincrement())
  type        String
  amount      Float
  price       Float
  status      String     @default("open")
  targetPrice Float?
  closedAt    DateTime?
  profit      Float?
  profitPct   Float?
  notes       String?
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
}
